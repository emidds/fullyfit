---
import fullyfitLogo from '../assets/fullyfit_logo.jpeg';
---

<nav class="site-banner" aria-label="Main navigation">
  <div class="brand-wrap">
    <div class="brand">
      <a href="/" aria-label="Fully Fit Studio">
        <img src={fullyfitLogo.src} alt="Fully Fit Studio" class="brand-logo" />
      </a>
    </div>

    <div class="nav-links group-links">
      <a href="/">Home</a>
      <a href="/our-studio">Our Studio</a>
      <a href="/classes">Classes</a>
      <a href="/contact">Contact</a>
    </div>
  </div>
</nav>

<style>
  .site-banner {
    background: #000000;
    color: #ffffff;
    padding: 0.5rem 0.75rem 0.75rem;
    box-shadow: 0 2px 8px rgba(28, 28, 28, 0.18);
  }

  .brand-wrap {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    width: 100%;
  }

  .brand {
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
  }

  .brand a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }

  .brand-logo {
    display: block;
    max-height: 104px;
    width: auto;
    object-fit: contain;
    vertical-align: middle;
  }

  .brand a,
  .nav-links a {
    color: #ffffff;
    text-decoration: none;
    font-weight: 700;
  }

  .nav-links {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: 1.5rem;
    margin-top: 0.5rem;
    width: 100%;
  }

  .nav-links a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    line-height: 1;
    opacity: 0.9;
    transition: opacity 0.2s ease;
  }

  .nav-links a:hover,
  .nav-links a:focus-visible {
    opacity: 1;
  }

  @media (max-width: 640px) {
    .site-banner {
      padding: 0.5rem 0.75rem 0.75rem;
    }

    .nav-links {
      justify-content: center;
      gap: 0.75rem 1rem;
    }
  }
</style>
