---
import SiteBanner from '../components/SiteBanner.astro';
const { title = 'Fully Fit PT Studio' } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
  </head>
  <body>
    <SiteBanner />
    <slot />
  </body>
</html>

<style>
  html,
  body {
    margin: 0;
    width: 100%;
    min-height: 100%;
    font-family: sans-serif;
  }

  body {
    background: #2f2f2f;
    color: #000000;
  }

  a {
    color: inherit;
  }
</style>
