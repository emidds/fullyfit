---
import Layout from '../layouts/Layout.astro';
const siteTitle = 'Our Studio';
---

<Layout title={siteTitle}>
  <main style="max-width: 900px; margin: 0 auto; padding: 2rem; color: #f3f4f6;">
    <section style="padding: 3rem 0;">
      <h1 style="margin-bottom: 1rem;">What we offer</h1>
      <p style="font-size: 1.1rem; line-height: 1.7; max-width: 700px;">
        At Fully Fit PT Studio in Red Beach, we offer personalised training and structured fitness solutions designed to help you build strength, improve fitness, and stay motivated.
      </p>
    </section>

    <!-- Services offered, in a grid layout -->
    <section style="display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 1rem;">
      <div style="background: #ffffff; color: #111111; border-radius: 10px; padding: 1.25rem;">
        <h3>1-on-1 Personal Training</h3>
        <p>Get personalised coaching tailored to your individual goals, fitness level, and experience. Sessions focus on effective training, correct technique, accountability, and steady progress.</p>
      </div>
      <div style="background: #ffffff; color: #111111; border-radius: 10px; padding: 1.25rem;">
        <h3>Group Personal Training</h3>
        <p>Train with others while still receiving expert coaching and guidance. Our small-group sessions create a supportive, motivating environment where you can work hard and enjoy the process.</p>
      </div>
      <div style="background: #ffffff; color: #111111; border-radius: 10px; padding: 1.25rem;">
        <h3>HIIT Group Classes</h3>
        <p>High-intensity interval training designed to challenge your fitness, strength, and conditioning. HIIT sessions combine a variety of exercises and training formats to keep workouts effective, engaging, and different every time. Suitable for all levels.</p>
      </div>
      <div style="background: #ffffff; color: #111111; border-radius: 10px; padding: 1.25rem;">
        <h3>Limited Membership</h3>
        <p>Our limited-membership approach keeps the studio focused on quality coaching and a great training environment. With limited numbers, members can train without the overcrowding of a large commercial gym.</p>
      </div>
         <div style="background: #ffffff; color: #111111; border-radius: 10px; padding: 1.25rem;">
        <h3>Program Design</h3>
        <p>Need a structured plan to follow? We can design an individual training program around your goals, experience, schedule, and available equipment—giving you a clear path to progress both inside and outside the studio.</p>
      </div>
    </section>

    <!-- Outro type text -->
    <section style="padding: 3rem 0;">
      <p style="font-size: 1.1rem; line-height: 1.7; max-width: 700px;">
        Whether you're looking for personal coaching, group training, high-intensity workouts, or a personalised program, Fully Fit PT Studio is here to help you train with purpose and achieve results.
      </p>
    </section>

    <!-- Instagram Feed -->
    <section style="margin-top: 3rem;">
      <div style="display: flex; align-items: center; justify-content: space-between; gap: 1rem; margin-bottom: 1rem; flex-wrap: wrap;">
        <h2 style="margin: 0; color: #f3f4f6;">Follow us on Instagram</h2>
        <a
          href="https://www.instagram.com/fullyfit_pt_studio/"
          target="_blank"
          rel="noreferrer"
          style="color: #ffffff; text-decoration: underline; font-weight: 700;"
        >
          @fullyfit_pt_studio
        </a>
      </div>

      <div style="width: 100%; overflow: hidden; border-radius: 16px; background: #ffffff; padding: 0.75rem;">
        <blockquote
          class="instagram-media"
          data-instgrm-permalink="https://www.instagram.com/fullyfit_pt_studio/"
          data-instgrm-version="12"
          style="background: #ffffff; border: 0; border-radius: 16px; box-shadow: 0 0 0 1px rgba(0,0,0,0.05); margin: 0; min-width: 220px; width: 100%;"
        ></blockquote>
      </div>
    </section>
  </main>

  <script async src="https://www.instagram.com/embed.js"></script>
</Layout>
