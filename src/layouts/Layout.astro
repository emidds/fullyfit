---
import SiteBanner from '../components/SiteBanner.astro';
const { title = 'Fully Fit PT Studio' } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
  </head>
  <body>
    <SiteBanner />
    <slot />

    <footer class="site-footer">
      <div class="footer-brand">Fully Fit PT Studio</div>
      <nav class="footer-nav" aria-label="Footer navigation">
        <a href="/">Home</a>
        <a href="/our-studio">Our Studio</a>
        <a href="/classes">Classes</a>
        <a href="/contact">Contact</a>
      </nav>
    </footer>
  </body>
</html>

<style>
  html,
  body {
    margin: 0;
    width: 100%;
    min-height: 100%;
    font-family: sans-serif;
  }

  body {
    background: #2f2f2f;
    color: #000000;
    display: flex;
    flex-direction: column;
  }

  a {
    color: inherit;
  }

  .site-footer {
    margin-top: auto;
    background: #b7943d;
    color: #000000;
    padding: 1.25rem 1.5rem 2rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    text-align: center;
  }

  .footer-brand {
    font-size: 1.1rem;
    font-weight: 700;
    letter-spacing: 0.04em;
  }

  .footer-nav {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 1rem;
  }

  .footer-nav a {
    color: #000000;
    text-decoration: underline;
    text-underline-offset: 0.15em;
    opacity: 0.9;
  }

  .footer-nav a:hover,
  .footer-nav a:focus-visible {
    opacity: 1;
  }
</style>
