---
import fullyfitLogo from '../assets/fullyfit_logo.jpeg';
---

<nav class="site-banner" aria-label="Main navigation">
  <div class="nav-links left-nav">
    <a href="/">Home</a>
    <a href="/our-studio">Our Studio</a>
  </div>

  <div class="brand">
    <a href="/" aria-label="Fully Fit Studio">
      <img src={fullyfitLogo.src} alt="Fully Fit Studio" class="brand-logo" />
    </a>
  </div>

  <div class="nav-links right-nav">
    <a href="/contact">Contact</a>
  </div>
</nav>

<style>
  .site-banner {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    background: #000000;
    color: #ffffff;
    padding: 0.5rem 0.75rem;
    box-shadow: 0 2px 8px rgba(28, 28, 28, 0.18);
  }

  .brand {
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    min-height: 100%;
  }

  .brand a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }

  .brand-logo {
    display: block;
    max-height: 104px;
    width: auto;
    object-fit: contain;
    vertical-align: middle;
  }

  .brand a,
  .nav-links a {
    color: #ffffff;
    text-decoration: none;
    font-weight: 700;
  }

  .nav-links {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1.25rem;
    min-height: 100%;
  }

  .left-nav {
    justify-content: flex-start;
  }

  .right-nav {
    justify-content: flex-end;
  }

  .nav-links a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    height: 100%;
    line-height: 1;
    opacity: 0.9;
    transition: opacity 0.2s ease;
  }

  .nav-links a:hover,
  .nav-links a:focus-visible {
    opacity: 1;
  }

  @media (max-width: 640px) {
    .site-banner {
      grid-template-columns: 1fr;
      justify-items: start;
      padding: 0.5rem 0.75rem;
      gap: 0.75rem;
    }

    .brand {
      text-align: left;
      width: 100%;
    }

    .left-nav,
    .right-nav {
      width: 100%;
      justify-content: flex-start;
    }
  }
</style>
