---
// Any server-side logic (like importing other components) goes here.
const siteTitle = "Fully Fit Studio";
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{siteTitle}</title>
    <style>
      body { font-family: sans-serif; line-height: 1.6; padding: 2rem; max-width: 800px; margin: auto; }
      .hero { text-align: center; padding: 3rem 0; }
      h1 { color: #333; }
      .services { display: flex; gap: 1rem; margin-top: 2rem; }
      .card { border: 1px solid #ccc; padding: 1rem; border-radius: 8px; flex: 1; }
    </style>
  </head>
  <body>
    <main>
      <section class="hero">
        <h1>Welcome to Fully Fit Studio!</h1>
        <p>We optimise humans for peak performance.</p>
      </section>

      <section class="services">
        <div class="card">
          <h3>Exclusive Personal Training Studio</h3>
          <p>We provide personal training with tailored programs to deliver real results.</p>
        </div>
        <div class="card">
          <h3>HIIT Training</h3>
          <p>Run around like a crazy person. You know you want to.</p>
        </div>
      </section>
    </main>
  </body>
</html>