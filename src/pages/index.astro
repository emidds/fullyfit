---
import Layout from '../layouts/Layout.astro';
import weightsImage from '../assets/weights.jpg';
const siteTitle = 'Fully Fit PT Studio';
---

<Layout title={siteTitle}>
  <main style="max-width: 900px; margin: 0 auto; padding: 2rem;">
    <section style="text-align: center; padding: 1rem 0;">
      <h1 style="color: #d1d5db;">Come and train with the Fully Fit team</h1>
      <!-- p style="color: #d1d5db; font-size: 1.2rem;">Personalised training that works.</p -->
    </section>

    <section style="margin: 2rem 0; border-radius: 12px; overflow: hidden; box-shadow: 0 6px 16px rgba(0, 0, 0, 0.2);">
      <img
        src={weightsImage.src}
        alt="Weights and fitness equipment"
        style="display: block; width: 100%; height: 360px; object-fit: cover;"
      />
    </section>

    <section style="display: flex; gap: 1rem; margin-top: 2rem; flex-wrap: wrap;">
      <div style="border: 1px solid #ccc; padding: 1rem; border-radius: 8px; flex: 1; min-width: 220px; background: white;">
        <h3 style="color: #000000;">Exclusive Personal Training</h3>
        <p>We provide a highly personalised training experience with tailored programs to deliver real results.</p>
      </div>
      <div style="border: 1px solid #ccc; padding: 1rem; border-radius: 8px; flex: 1; min-width: 220px; background: white;">
        <h3 style="color: #000000;">HIIT Training</h3>
        <p>High-intensity interval training for maximum calorie burn and cardiovascular fitness.</p>
      </div>
    </section>
  </main>
</Layout>
